datasource db {
  provider = "mongodb"
  url      = env("DATABASE_URL")
}

generator client {
  provider = "prisma-client-js"
}

enum Role {
  USER
  MANAGER
  ADMIN
}

enum TargetGroup {
  MEN
  WOMEN
  KIDS
  UNISEX
  OTHERS
  SCHOOL
  SPORTS
}

enum OrderStatus {
  PENDING
  PROCESSING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum PaymentMethod {
  COD
  DIGITAL
  BKASH
}

model User {
  id            String   @id @default(auto()) @map("_id") @db.ObjectId
  email         String   @unique
  password      String
  name          String
  role          Role     @default(USER)
  phone         String?
  profileImage  String?
  isDeleted     Boolean  @default(false)
  otp           String?
  otpExpiresAt  DateTime?
  resetToken    String?
  resetExpires  DateTime?
  isVerified    Boolean  @default(false)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  orders        Order[]
  reviews       Review[]
}

model Category {
  id           String        @id @default(auto()) @map("_id") @db.ObjectId
  name         String
  slug         String        @unique
  parentId     String?       @db.ObjectId
  parent       Category?     @relation("CategoryToCategory", fields: [parentId], references: [id], onDelete: NoAction, onUpdate: NoAction)
  children     Category[]    @relation("CategoryToCategory")
  targetGroups TargetGroup[] @default([UNISEX])
  products     Product[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([parentId])
}

model Product {
  id          String           @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String           @unique
  description String
  price       Float
  costPrice   Float            @default(0)
  discount    Float            @default(0)
  categoryId  String           @db.ObjectId
  category    Category         @relation(fields: [categoryId], references: [id])
  targetGroup TargetGroup      @default(UNISEX)
  images      String[]
  isPublished Boolean          @default(true)
  metadata    Json?
  variants    ProductVariant[]
  reviews     Review[]
  createdAt   DateTime         @default(now())
  updatedAt   DateTime         @updatedAt

  @@index([categoryId])
  @@index([targetGroup])
  @@index([isPublished])
}

model ProductVariant {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  sku       String   @unique
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  size      String?
  color     String?
  stock     Int      @default(0)
  price     Float?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
}

model Order {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  userId          String          @db.ObjectId
  user            User            @relation(fields: [userId], references: [id])
  items           OrderItem[]
  totalAmount     Float
  shippingAddress ShippingAddress
  paymentMethod   PaymentMethod   @default(COD)
  bkashNumber     String?
  bkashTrxId      String?
  status          OrderStatus     @default(PENDING)
  couponCode      String?
  discountAmount  Float           @default(0)
  giftCardCode    String?
  giftCardAmount  Float           @default(0)
  giftCard        GiftCard?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt

  @@index([userId])
  @@index([status])
}

type OrderItem {
  variantId String @db.ObjectId
  sku       String
  title     String
  size      String?
  color     String?
  price     Float
  quantity  Int
}

type ShippingAddress {
  street  String
  city    String
  state   String
  zipCode String
  country String
  phone   String
}

model Review {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  productId String   @db.ObjectId
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  userId    String   @db.ObjectId
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  userName  String
  rating    Int
  comment   String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@index([productId])
  @@index([userId])
}

model BlogPost {
  id          String   @id @default(auto()) @map("_id") @db.ObjectId
  title       String
  slug        String   @unique
  content     String
  excerpt     String
  coverImage  String
  isPublished Boolean  @default(true)
  author      String   @default("Pristto Team")
  readTime    String   @default("5 min read")
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Discount {
  id            String    @id @default(auto()) @map("_id") @db.ObjectId
  code          String    @unique
  discountValue Float
  type          String    @default("PERCENTAGE")
  isActive      Boolean   @default(true)
  minSpend      Float     @default(0)
  expiryDate    DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
}

type QuotationItem {
  sku         String
  description String
  uom         String
  quantity    Float
}

model Quotation {
  id              String          @id @default(auto()) @map("_id") @db.ObjectId
  quotationNo     String          @unique
  companyName     String
  contactPerson   String
  mobile          String
  email           String
  billingAddress  String
  shippingAddress String
  items           QuotationItem[]
  comment         String?
  status          String          @default("Submit")
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
}

model ContentSetting {
  id        String   @id @default(auto()) @map("_id") @db.ObjectId
  key       String   @unique
  value     String
  updatedAt DateTime @updatedAt
}

model GiftCard {
  id             String    @id @default(auto()) @map("_id") @db.ObjectId
  code           String    @unique
  initialBalance Float
  balance        Float
  recipientEmail String
  senderName     String
  message        String?
  isActive       Boolean   @default(false)
  expiryDate     DateTime?
  orderId        String?   @db.ObjectId @unique
  order          Order?    @relation(fields: [orderId], references: [id])
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
